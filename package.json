{
  "name": "oneweb",
  "type": "module",
  "version": "0.1.0",
  "description": "OneWeb Backoffice API Services",
  "main": "src/index.js",
  "repository": "https://github.com/jimzhan/oneweb",
  "author": "jimzhan <jim.zhan@me.com>",
  "license": "Apache-2.0",
  "private": false,
  "aliases": {
    "settings": "settings/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "infra:up": "docker-compose --file infra/docker-compose.yml up -d",
    "infra:stop": "docker-compose --file infra/docker-compose.yml stop",
    "lint": "eslint --fix --ignore-path .eslintignore",
    "start": "cross-env NODE_ENV=production node --no-experimental-require-module --loader esm-module-alias/loader --no-warnings ./src/index.js",
    "watch": "cross-env NODE_ENV=development nodemon --loader esm-module-alias/loader --no-warnings ./src/index.js",
    "test": "c8 ava"
  },
  "dependencies": {
    "@hapi/glue": "^9.0.1",
    "@hapi/hapi": "^21.4.0",
    "@hapi/inert": "^7.1.0",
    "@hapi/log": "^2.0.1",
    "@hapi/vision": "^7.0.3",
    "@hapi/yar": "^11.0.2",
    "@hapipal/confidence": "^6.0.2",
    "cross-env": "^7.0.3",
    "esm-module-alias": "^2.2.1",
    "exiting": "^7.0.0",
    "hapi-swagger": "^17.3.2",
    "http-status": "^2.1.0",
    "i18next": "^24.2.2",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.7.1",
    "immutable": "^5.0.3",
    "module-alias": "^2.2.3",
    "nanoid": "^5.1.3",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "ava": "^6.2.0",
    "c8": "^10.1.3",
    "eslint": "8.x",
    "eslint-config-prettier": "^10.1.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.16.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^7.2.1",
    "nodemon": "^3.1.9"
  }
}
